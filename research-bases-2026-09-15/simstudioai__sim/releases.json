site_admin": false}, "content_type": "application/octet-stream", "state": "uploaded", "size": 237041, "digest": "sha256:66bed9b0488182b979c5d8b6e268e075d5544201f059543b2cddf350a4834359", "download_count": 2, "created_at": "2026-09-15T06:48:02Z", "updated_at": "2026-09-15T06:48:02Z", "browser_download_url": "https://github.com/simstudioai/sim/releases/download/v0.8.37/Sim-0.8.37-universal.zip.blockmap"}], "tarball_url": "https://api.github.com/repos/simstudioai/sim/tarball/v0.8.37", "zipball_url": "https://api.github.com/repos/simstudioai/sim/zipball/v0.8.37", "body": "## Features\n\n- feat(sso): let an organization keep several identity providers on one domain and choose the primary (#7836)\n- feat(slack): support organization-scoped shared app rollout (#7833)\n- feat(agent): allow variable tool permission modes (#7538)\n- feat(slack): switch custom bots to the Sim Search app (#7811)\n- feat(audit): record the client surface on audit entries and identify CLI login requests (#7823)\n\n## Improvements\n\n- improvement(desktop): remove per-task website approval prompts (#7837)\n- improvement(editor): render tool permission mode and retry fields with standard sub-block inputs (#7834)\n- improvement(analytics): attribute every request, credential, and queued run (#7835)\n- improvement(search): speed up organization integration and source queries (#7830)\n\n## Bug Fixes\n\n- fix(db): allow five hours for database migrations (#7838)\n- fix(search): bound retrieval and resume projection upgrades (#7824)\n- fix(confluence): drop scripts, styles, and unresolved Jira placeholders from indexed page text (#7831)\n- fix(desktop): unify shell dialogs and recovery screens with emcn (#7828)\n- fix(chat): render deployed file outputs inline (#7826)\n- fix(tables): use explicit timestamps for expiration (#7689)\n- fix(agent): retain conversation memory attachments (#7818)\n\n## Other Changes\n\n- docs(agent): document the variable tool Permission Mode (#7832)\n\n## Contributors\n\n- @TheodoreSpeaks\n- @icecrasher321\n- @j15z\n- @waleedlatif1\n\n[View changes on GitHub](https://github.com/simstudioai/sim/compare/v0.8.36...v0.8.37)", "mentions_count": 4}, {"url": "https://api.github.com/repos/simstudioai/sim/releases/388632461", "assets_url": "https://api.github.com/repos/simstudioai/sim/releases/388632461/assets", "upload_url": "https://uploads.github.com/repos/simstudioai/sim/releases/388632461/assets{?name,label}", "html_url": "https://github.com/simstudioai/sim/releases/tag/v0.8.35", "id": 388632461, "author": {"login": "github-actions[bot]", "id": 41898282, "node_id": "MDM6Qm90NDE4OTgyODI=", "avatar_url": "https://avatars.githubusercontent.com/in/15368?v=4", "gravatar_id": "", "url": "https://api.github.com/users/github-actions%5Bbot%5D", "html_url": "https://github.com/apps/github-actions", "followers_url": "https://api.github.com/users/github-actions%5Bbot%5D/followers", "following_url": "https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}", "gists_url": "https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}", "starred_url": "https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/github-actions%5Bbot%5D/subscriptions", "organizations_url": "https://api.github.com/users/github-actions%5Bbot%5D/orgs", "repos_url": "https://api.github.com/users/github-actions%5Bbot%5D/repos", "events_url": "https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}", "received_events_url": "https://api.github.com/users/github-actions%5Bbot%5D/received_events", "type": "Bot", "user_view_type": "public", "site_admin": false}, "node_id": "RE_kwDONmSNmM4XKg-N", "tag_name": "v0.8.35", "target_commitish": "4b3a9df9b4a659c5764a21a324d5d1d12d2f97df", "name": "v0.8.35", "draft": false, "immutable": false, "prerelease": false, "created_at": "2026-09-14T18:20:02Z", "updated_at": "2026-09-14T18:55:58Z", "published_at": "2026-09-14T18:48:04Z", "assets